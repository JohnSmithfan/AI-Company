# Editor configuration for ai-company
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

# PowerShell scripts are authored with LF. scripts/self-scale.ps1 normalises
# every artifact it writes to LF (E15) and carries LF-sensitive here-strings,
# so the file itself must stay LF; .gitattributes pins this for checkouts.
[*.ps1]
indent_style = space
indent_size = 2
end_of_line = lf
