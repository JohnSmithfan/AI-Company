{
  "id": "{{MODEL_ID}}",
  "provider": "{{PROVIDER}}",
  "type": "local",
  "endpoint": "{{LOCAL_ENDPOINT}}",
  "env_var_name": "",
  "context_window": 0,
  "max_output_tokens": 0,
  "pii_filtering": true,
  "rate_limits": {
    "rpm": 0,
    "tpm": 0,
    "daily": 0
  },
  "runtime": {
    "engine": "{{ollama|llama-cpp|vllm}}",
    "model_path": "{{PATH_TO_WEIGHTS}}",
    "gpu_layers": 0,
    "requires_auth": false
  }
}
