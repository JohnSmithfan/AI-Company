{
  "id": "gpt-4o",
  "provider": "openai",
  "type": "api",
  "endpoint": "https://api.openai.com/v1/chat/completions",
  "env_var_name": "OPENAI_API_KEY",
  "context_window": 128000,
  "max_output_tokens": 16384,
  "pii_filtering": true,
  "rate_limits": {
    "rpm": 120,
    "tpm": 180000,
    "daily": 10000
  }
}
